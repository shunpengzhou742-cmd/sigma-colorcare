rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /employeeInvites/{inviteId} {
      allow get: if isAdmin()
        || (isGoogleUser()
            && resource.data.status == 'active'
            && resource.data.expiresAt > request.time);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'departmentIds', 'repairTypeIds', 'status', 'expiresAt',
          'createdAt', 'createdBy', 'usedBy', 'usedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'departmentIds', 'repairTypeIds', 'status', 'expiresAt',
          'createdAt', 'createdBy', 'usedBy', 'usedAt'
        ])
        && request.resource.data.departmentIds is list
        && request.resource.data.departmentIds.size() >= 1
        && request.resource.data.departmentIds.size() <= 3
        && request.resource.data.departmentIds.hasOnly([1, 2, 3])
        && request.resource.data.repairTypeIds is list
        && (request.resource.data.departmentIds.hasAny([1])
            ? request.resource.data.repairTypeIds == [101, 102]
            : request.resource.data.repairTypeIds == [])
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(1, 'd')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;

      allow update: if isGoogleUser()
        && !isAdmin()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedBy', 'usedAt'
        ])
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/employees/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.invitationId == inviteId
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds == resource.data.departmentIds
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.repairTypeIds == resource.data.repairTypeIds;

      allow delete: if false;
    }

    match /employees/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isGoogleUser()
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'roleType', 'status', 'departmentIds',
          'repairTypeIds', 'specialRole', 'invitationId', 'createdAt',
          'createdBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'roleType', 'status', 'departmentIds',
          'repairTypeIds', 'specialRole', 'invitationId', 'createdAt',
          'createdBy', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roleType == 1
        && request.resource.data.status == 'active'
        && request.resource.data.departmentIds is list
        && request.resource.data.repairTypeIds is list
        && request.resource.data.specialRole == false
        && request.resource.data.invitationId is string
        && exists(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId))
        && get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.status == 'active'
        && get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.usedBy == request.auth.uid
        && request.resource.data.departmentIds == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.departmentIds
        && request.resource.data.repairTypeIds == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.repairTypeIds
        && request.resource.data.createdBy == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.createdBy
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'departmentIds', 'repairTypeIds', 'status', 'updatedAt'
        ])
        && request.resource.data.departmentIds is list
        && request.resource.data.departmentIds.size() >= 1
        && request.resource.data.departmentIds.size() <= 3
        && request.resource.data.departmentIds.hasOnly([1, 2, 3])
        && request.resource.data.repairTypeIds is list
        && (request.resource.data.departmentIds.hasAny([1])
            ? request.resource.data.repairTypeIds == [101, 102]
            : request.resource.data.repairTypeIds == [])
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /appSettings/departmentWages {
      allow get, create, update: if isAdmin();
      allow list, delete: if false;
    }

    match /dailyRecords/{recordId} {
      allow get, list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
