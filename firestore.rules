rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveEmployee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.roleType == 1;
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /employeeInvites/{inviteId} {
      allow get: if isAdmin()
        || (isGoogleUser()
            && resource.data.status == 'active'
            && resource.data.expiresAt > request.time);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'departmentIds', 'repairTypeIds', 'status', 'expiresAt',
          'createdAt', 'createdBy', 'usedBy', 'usedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'departmentIds', 'repairTypeIds', 'status', 'expiresAt',
          'createdAt', 'createdBy', 'usedBy', 'usedAt'
        ])
        && request.resource.data.departmentIds is list
        && request.resource.data.departmentIds.size() >= 1
        && request.resource.data.departmentIds.size() <= 3
        && request.resource.data.departmentIds.hasOnly([1, 2, 3])
        && request.resource.data.repairTypeIds is list
        && (request.resource.data.departmentIds.hasAny([1])
            ? request.resource.data.repairTypeIds == [101, 102]
            : request.resource.data.repairTypeIds == [])
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(1, 'd')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;

      allow update: if isGoogleUser()
        && !isAdmin()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedBy', 'usedAt'
        ])
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/employees/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.invitationId == inviteId
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds == resource.data.departmentIds
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.repairTypeIds == resource.data.repairTypeIds;

      allow delete: if false;
    }

    match /employees/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isGoogleUser()
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'roleType', 'status', 'departmentIds',
          'repairTypeIds', 'specialRole', 'invitationId', 'createdAt',
          'createdBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'roleType', 'status', 'departmentIds',
          'repairTypeIds', 'specialRole', 'invitationId', 'createdAt',
          'createdBy', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roleType == 1
        && request.resource.data.status == 'active'
        && request.resource.data.departmentIds is list
        && request.resource.data.repairTypeIds is list
        && request.resource.data.specialRole == false
        && request.resource.data.invitationId is string
        && exists(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId))
        && get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.status == 'active'
        && get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.usedBy == request.auth.uid
        && request.resource.data.departmentIds == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.departmentIds
        && request.resource.data.repairTypeIds == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.repairTypeIds
        && request.resource.data.createdBy == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.createdBy
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'departmentIds', 'repairTypeIds', 'status', 'updatedAt'
        ])
        && request.resource.data.departmentIds is list
        && request.resource.data.departmentIds.size() >= 1
        && request.resource.data.departmentIds.size() <= 3
        && request.resource.data.departmentIds.hasOnly([1, 2, 3])
        && request.resource.data.repairTypeIds is list
        && (request.resource.data.departmentIds.hasAny([1])
            ? request.resource.data.repairTypeIds == [101, 102]
            : request.resource.data.repairTypeIds == [])
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function isActiveRepairEmployee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.roleType == 1
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds.hasAny([1]);
    }

    match /repairWorkOrders/{workOrderId} {
      allow create: if isActiveRepairEmployee()
        && request.resource.data.keys().hasAll([
          'employeeUid', 'createdBy', 'departmentId', 'repairTypeId',
          'workDate', 'orderNo', 'styleNo', 'color', 'quantity',
          'note', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'employeeUid', 'createdBy', 'departmentId', 'repairTypeId',
          'workDate', 'orderNo', 'styleNo', 'color', 'quantity',
          'note', 'status', 'createdAt'
        ])
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.departmentId == 1
        && request.resource.data.repairTypeId in [101, 102]
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.repairTypeIds.hasAny([request.resource.data.repairTypeId])
        && request.resource.data.workDate is string
        && request.resource.data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.size() <= 80
        && request.resource.data.styleNo is string
        && request.resource.data.styleNo.size() <= 80
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 80
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time;

      allow get, list: if isAdmin()
        || (isActiveRepairEmployee()
            && resource.data.employeeUid == request.auth.uid
            && resource.data.departmentId == 1);
      allow update, delete: if false;
    }

    function isActiveDepartmentEmployee(departmentId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.roleType == 1
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds.hasAny([departmentId]);
    }

    function validGenericWorkOrder(data, departmentId) {
      return data.keys().hasAll(['employeeUid', 'createdBy', 'departmentId', 'workDate', 'orderNo', 'styleNo', 'color', 'quantity', 'note', 'status', 'createdAt'])
        && data.keys().hasOnly(['employeeUid', 'createdBy', 'departmentId', 'workDate', 'orderNo', 'styleNo', 'color', 'quantity', 'note', 'status', 'createdAt'])
        && data.employeeUid == request.auth.uid
        && data.createdBy == request.auth.uid
        && data.departmentId == departmentId
        && data.workDate is string
        && data.workDate.size() == 10
        && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.orderNo is string && data.orderNo.size() <= 80
        && data.styleNo is string && data.styleNo.size() <= 80
        && data.color is string && data.color.size() <= 80
        && data.quantity is int && data.quantity > 0 && data.quantity <= 1000000
        && data.note is string && data.note.size() <= 500
        && data.status == 'submitted'
        && data.createdAt == request.time;
    }

    match /cleanWorkOrders/{workOrderId} {
      allow create: if isActiveDepartmentEmployee(2) && validGenericWorkOrder(request.resource.data, 2);
      allow get, list: if isAdmin() || (isActiveDepartmentEmployee(2) && resource.data.employeeUid == request.auth.uid && resource.data.departmentId == 2);
      allow update, delete: if false;
    }

    match /weaveWorkOrders/{workOrderId} {
      allow create: if isActiveDepartmentEmployee(3) && validGenericWorkOrder(request.resource.data, 3);
      allow get, list: if isAdmin() || (isActiveDepartmentEmployee(3) && resource.data.employeeUid == request.auth.uid && resource.data.departmentId == 3);
      allow update, delete: if false;
    }
    function validDepartmentRequest(data, departmentId, isScrap) {
      return data.keys().hasAll(['requestDate', 'departmentId', 'employeeUid', 'createdBy', 'orderNo', 'styleNo', 'quantity', 'note', 'status', 'createdAt'])
        && (isScrap ? data.keys().hasAll(['reason']) : true)
        && (isScrap ? data.keys().hasOnly(['requestDate', 'departmentId', 'employeeUid', 'createdBy', 'orderNo', 'styleNo', 'quantity', 'note', 'status', 'createdAt', 'reason']) : data.keys().hasOnly(['requestDate', 'departmentId', 'employeeUid', 'createdBy', 'orderNo', 'styleNo', 'quantity', 'note', 'status', 'createdAt']))
        && data.requestDate is string && data.requestDate.size() == 10
        && data.requestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.departmentId == departmentId && data.departmentId in [1, 2, 3]
        && data.employeeUid == request.auth.uid && data.createdBy == request.auth.uid
        && data.orderNo is string && data.orderNo.size() <= 80
        && data.styleNo is string && data.styleNo.size() <= 80
        && data.quantity is int && data.quantity > 0 && data.quantity <= 1000000
        && data.note is string && data.note.size() <= 500
        && data.status == 'submitted' && data.createdAt == request.time
        && (isScrap ? (data.reason is string && data.reason.size() > 0 && data.reason.size() <= 300) : true);
    }

    function validScrapReview() {
      return isAdmin()
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 300;
    }

    match /scrapRequests/{requestId} {
      allow create: if isActiveDepartmentEmployee(request.resource.data.departmentId)
        && validDepartmentRequest(request.resource.data, request.resource.data.departmentId, true);
      allow get, list: if isAdmin() || (isActiveDepartmentEmployee(resource.data.departmentId) && resource.data.employeeUid == request.auth.uid);
      allow update: if validScrapReview();
      allow delete: if false;
    }

    match /appSettings/departmentWages {
      allow get, create, update: if isAdmin();
      allow list, delete: if false;
    }

    match /appSettings/vietnamHolidayThemes {
      // This document contains public appearance preferences only, not business or employee data.
      // Signed-in active employees may read it; only an active admin may change it.
      allow get: if isAdmin() || isActiveEmployee();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['enabledHolidayIds', 'advanceDays', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['enabledHolidayIds', 'advanceDays', 'updatedAt', 'updatedBy'])
        && request.resource.data.enabledHolidayIds is list
        && request.resource.data.enabledHolidayIds.size() <= 12
        && request.resource.data.enabledHolidayIds.hasOnly([
          'new-year', 'women', 'reunification', 'children', 'national', 'teachers',
          'christmas', 'tet', 'hung-kings', 'dragon-boat', 'vu-lan', 'mid-autumn'
        ])
        && request.resource.data.advanceDays is int
        && request.resource.data.advanceDays >= 0
        && request.resource.data.advanceDays <= 30
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow list, delete: if false;
    }


    match /operatingExpenses/{expenseId} {
      function validExpense(data) {
        return data.keys().hasAll([
          'expenseDate', 'category', 'departmentId', 'entryMode',
          'amount', 'note', 'currency', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'expenseDate', 'category', 'departmentId', 'entryMode',
          'amount', 'note', 'currency', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.expenseDate is string
        && data.expenseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.category in ['transport', 'utilities', 'maintenance', 'office', 'meals', 'other']
        && data.departmentId in [0, 1, 2, 3]
        && data.entryMode in ['item', 'dailySummary']
        && data.amount is number
        && data.amount > 0
        && data.note is string
        && data.note.size() <= 300
        && data.currency == 'VND'
        && data.createdBy is string
        && data.createdBy.size() > 0;
      }

      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && validExpense(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validExpense(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /dailyRecords/{recordId} {
      allow get, list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
