rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /employeeInvites/{inviteId} {
      allow get: if isAdmin()
        || (isGoogleUser()
            && resource.data.status == 'active'
            && resource.data.expiresAt > request.time);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'departmentIds', 'repairTypeIds', 'status', 'expiresAt',
          'createdAt', 'createdBy', 'usedBy', 'usedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'departmentIds', 'repairTypeIds', 'status', 'expiresAt',
          'createdAt', 'createdBy', 'usedBy', 'usedAt'
        ])
        && request.resource.data.departmentIds is list
        && request.resource.data.departmentIds.size() >= 1
        && request.resource.data.departmentIds.size() <= 3
        && request.resource.data.departmentIds.hasOnly([1, 2, 3])
        && request.resource.data.repairTypeIds is list
        && (request.resource.data.departmentIds.hasAny([1])
            ? request.resource.data.repairTypeIds == [101, 102]
            : request.resource.data.repairTypeIds == [])
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(1, 'd')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;

      allow update: if (
        isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'revokedBy', 'revokedAt'
        ])
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt == request.time
      ) || (
        isGoogleUser()
        && !isAdmin()
        && resource.data.status == 'active'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedBy', 'usedAt'
        ])
        && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/employees/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.invitationId == inviteId
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds == resource.data.departmentIds
        && getAfter(/databases/$(database)/documents/employees/$(request.auth.uid)).data.repairTypeIds == resource.data.repairTypeIds
      );

      allow delete: if false;
    }

    match /employees/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isGoogleUser()
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'roleType', 'status', 'departmentIds',
          'repairTypeIds', 'specialRole', 'invitationId', 'createdAt',
          'createdBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'roleType', 'status', 'departmentIds',
          'repairTypeIds', 'specialRole', 'invitationId', 'createdAt',
          'createdBy', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.roleType == 1
        && request.resource.data.specialRole == false
        && request.resource.data.status == 'active'
        && request.resource.data.departmentIds is list
        && request.resource.data.repairTypeIds is list
        && request.resource.data.invitationId is string
        && exists(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId))
        && get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.status == 'active'
        && get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.status == 'used'
        && getAfter(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.usedBy == request.auth.uid
        && request.resource.data.departmentIds == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.departmentIds
        && request.resource.data.repairTypeIds == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.repairTypeIds
        && request.resource.data.createdBy == get(/databases/$(database)/documents/employeeInvites/$(request.resource.data.invitationId)).data.createdBy
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'departmentIds', 'repairTypeIds', 'status', 'specialRole', 'updatedAt'
        ])
        && request.resource.data.departmentIds is list
        && request.resource.data.departmentIds.size() >= 1
        && request.resource.data.departmentIds.size() <= 3
        && request.resource.data.departmentIds.hasOnly([1, 2, 3])
        && request.resource.data.repairTypeIds is list
        && (request.resource.data.departmentIds.hasAny([1])
            ? request.resource.data.repairTypeIds == [101, 102]
            : request.resource.data.repairTypeIds == [])
        && request.resource.data.status in ['active', 'disabled']
        && (!request.resource.data.keys().hasAny(['specialRole']) || request.resource.data.specialRole is bool)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    function isActiveRepairEmployee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.roleType == 1
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds.hasAny([1]);
    }

    match /repairWorkOrders/{workOrderId} {
      allow create: if isActiveRepairEmployee()
        && request.resource.data.keys().hasAll([
          'employeeUid', 'createdBy', 'departmentId', 'repairTypeId',
          'workDate', 'orderNo', 'styleNo', 'color', 'quantity',
          'note', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'employeeUid', 'createdBy', 'departmentId', 'repairTypeId',
          'workDate', 'orderNo', 'styleNo', 'color', 'quantity',
          'note', 'status', 'createdAt'
        ])
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.departmentId == 1
        && request.resource.data.repairTypeId in [101, 102]
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.repairTypeIds.hasAny([request.resource.data.repairTypeId])
        && request.resource.data.workDate is string
        && request.resource.data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.orderNo is string
        && request.resource.data.orderNo.size() <= 80
        && request.resource.data.styleNo is string
        && request.resource.data.styleNo.size() <= 80
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 80
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time;

      allow get, list: if isAdmin()
        || (isActiveRepairEmployee()
            && resource.data.employeeUid == request.auth.uid
            && resource.data.departmentId == 1);
      allow update, delete: if false;
    }

    function isActiveDepartmentEmployee(departmentId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.roleType == 1
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.departmentIds.hasAny([departmentId]);
    }

    function validGenericWorkOrder(data, departmentId) {
      return data.keys().hasAll(['employeeUid', 'createdBy', 'departmentId', 'workDate', 'orderNo', 'styleNo', 'color', 'quantity', 'note', 'status', 'createdAt'])
        && data.keys().hasOnly(['employeeUid', 'createdBy', 'departmentId', 'workDate', 'orderNo', 'styleNo', 'color', 'quantity', 'note', 'status', 'createdAt'])
        && data.employeeUid == request.auth.uid
        && data.createdBy == request.auth.uid
        && data.departmentId == departmentId
        && data.workDate is string
        && data.workDate.size() == 10
        && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.orderNo is string && data.orderNo.size() <= 80
        && data.styleNo is string && data.styleNo.size() <= 80
        && data.color is string && data.color.size() <= 80
        && data.quantity is int && data.quantity > 0 && data.quantity <= 1000000
        && data.note is string && data.note.size() <= 500
        && data.status == 'submitted'
        && data.createdAt == request.time;
    }

    match /cleanWorkOrders/{workOrderId} {
      allow create: if isActiveDepartmentEmployee(2) && validGenericWorkOrder(request.resource.data, 2);
      allow get, list: if isAdmin() || (isActiveDepartmentEmployee(2) && resource.data.employeeUid == request.auth.uid && resource.data.departmentId == 2);
      allow update, delete: if false;
    }

    match /weaveWorkOrders/{workOrderId} {
      allow create: if isActiveDepartmentEmployee(3) && validGenericWorkOrder(request.resource.data, 3);
      allow get, list: if isAdmin() || (isActiveDepartmentEmployee(3) && resource.data.employeeUid == request.auth.uid && resource.data.departmentId == 3);
      allow update, delete: if false;
    }
    function validScrapBatch(data, requestId) {
      return data.workOrderId is string && data.workOrderId.size() > 0
        && data.sourceCollection in ['repairWorkOrders', 'cleanWorkOrders', 'weaveWorkOrders']
        && requestId == 'scrap_' + data.sourceCollection + '_' + data.workOrderId
        && (
          (data.sourceCollection == 'repairWorkOrders'
            && exists(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId))
            && get(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId)).data.employeeUid == request.auth.uid
            && get(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId)).data.departmentId == data.departmentId
            && get(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId)).data.orderNo == data.orderNo
            && get(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId)).data.styleNo == data.styleNo
            && get(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId)).data.quantity is int
            && data.quantity <= get(/databases/$(database)/documents/repairWorkOrders/$(data.workOrderId)).data.quantity)
          || (data.sourceCollection == 'cleanWorkOrders'
            && exists(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId))
            && get(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId)).data.employeeUid == request.auth.uid
            && get(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId)).data.departmentId == data.departmentId
            && get(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId)).data.orderNo == data.orderNo
            && get(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId)).data.styleNo == data.styleNo
            && get(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId)).data.quantity is int
            && data.quantity <= get(/databases/$(database)/documents/cleanWorkOrders/$(data.workOrderId)).data.quantity)
          || (data.sourceCollection == 'weaveWorkOrders'
            && exists(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId))
            && get(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId)).data.employeeUid == request.auth.uid
            && get(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId)).data.departmentId == data.departmentId
            && get(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId)).data.orderNo == data.orderNo
            && get(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId)).data.styleNo == data.styleNo
            && get(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId)).data.quantity is int
            && data.quantity <= get(/databases/$(database)/documents/weaveWorkOrders/$(data.workOrderId)).data.quantity)
        );
    }

    function validDepartmentRequest(data, departmentId, isScrap, requestId) {
      return data.keys().hasAll(['requestDate', 'departmentId', 'employeeUid', 'createdBy', 'orderNo', 'styleNo', 'quantity', 'note', 'status', 'createdAt'])
        && (isScrap ? data.keys().hasAll(['reason', 'workOrderId', 'sourceCollection']) : true)
        && (isScrap ? data.keys().hasOnly(['requestDate', 'departmentId', 'employeeUid', 'createdBy', 'orderNo', 'styleNo', 'quantity', 'note', 'status', 'createdAt', 'reason', 'workOrderId', 'sourceCollection']) : data.keys().hasOnly(['requestDate', 'departmentId', 'employeeUid', 'createdBy', 'orderNo', 'styleNo', 'quantity', 'note', 'status', 'createdAt']))
        && data.requestDate is string && data.requestDate.size() == 10
        && data.requestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.departmentId == departmentId && data.departmentId in [1, 2, 3]
        && data.employeeUid == request.auth.uid && data.createdBy == request.auth.uid
        && data.orderNo is string && data.orderNo.size() <= 80
        && data.styleNo is string && data.styleNo.size() <= 80
        && data.quantity is int && data.quantity > 0 && data.quantity <= 1000000
        && data.note is string && data.note.size() <= 500
        && data.status == 'submitted' && data.createdAt == request.time
        && (isScrap ? (data.reason is string && data.reason.size() > 0 && data.reason.size() <= 300 && validScrapBatch(data, requestId)) : true);
    }

    function validScrapReview() {
      return isAdmin()
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNote'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 300
        && (request.resource.data.status == 'rejected' ? request.resource.data.reviewNote.size() > 0 : true);
    }

    function validScrapResubmission(requestId) {
      return isActiveDepartmentEmployee(resource.data.departmentId)
        && resource.data.employeeUid == request.auth.uid
        && resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestDate', 'quantity', 'reason', 'note', 'status', 'updatedAt'])
        && request.resource.data.status == 'submitted'
        && request.resource.data.requestDate is string
        && request.resource.data.requestDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 1000000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt == request.time
        && validScrapBatch(request.resource.data, requestId)
        && request.resource.data.workOrderId == resource.data.workOrderId
        && request.resource.data.sourceCollection == resource.data.sourceCollection
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /scrapRequests/{requestId} {
      allow create: if isActiveDepartmentEmployee(request.resource.data.departmentId)
        && validDepartmentRequest(request.resource.data, request.resource.data.departmentId, true, requestId);
      allow get, list: if isAdmin() || (isActiveDepartmentEmployee(resource.data.departmentId) && resource.data.employeeUid == request.auth.uid);
      allow update: if validScrapReview() || validScrapResubmission(requestId);
      allow delete: if false;
    }


    // Attendance and wage snapshots: employees may read only their own active records; managers own all writes.
    match /employeeAttendance/{attendanceId} {
      function validAttendance(data) {
        return data.keys().hasAll([
          'employeeUid', 'employeeName', 'workDate', 'departmentId',
          'payableDays', 'dailyWage', 'wageAmount', 'wageEffectiveDate',
          'createdBy', 'createdAt', 'updatedAt'
        ])
          && data.keys().hasOnly([
            'employeeUid', 'employeeName', 'workDate', 'departmentId',
            'payableDays', 'dailyWage', 'wageAmount', 'wageEffectiveDate',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && data.employeeUid is string
          && data.employeeUid.size() > 0
          && data.employeeUid.size() <= 128
          && data.employeeName is string
          && data.employeeName.size() > 0
          && data.employeeName.size() <= 100
          && data.workDate is string
          && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.departmentId is int
          && data.departmentId in [1, 2, 3]
          && data.payableDays is number
          && data.payableDays > 0
          && data.payableDays <= 1
          && data.dailyWage is number
          && data.dailyWage >= 0
          && data.wageAmount is number
          && data.wageAmount >= 0
          && data.wageAmount == data.payableDays * data.dailyWage
          && data.wageEffectiveDate is string
          && (data.wageEffectiveDate == 'manual'
              || data.wageEffectiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && data.createdBy is string
          && data.createdBy.size() > 0
          && data.createdBy.size() <= 128;
      }

      allow get, list: if isAdmin() || (request.auth != null
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'active'
        && resource.data.employeeUid == request.auth.uid);

      allow create: if isAdmin()
        && validAttendance(request.resource.data)
        && exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeUid))
        && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeUid)).data.status == 'active'
        && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeUid)).data.departmentIds.hasAny([request.resource.data.departmentId])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validAttendance(request.resource.data)
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.workDate == resource.data.workDate
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeUid))
        && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeUid)).data.departmentIds.hasAny([request.resource.data.departmentId]);

      allow delete: if false;
    }

    match /appSettings/departmentWages {
      allow get, create, update: if isAdmin();
      allow list, delete: if false;
    }

    match /operatingExpenses/{expenseId} {
      function validExpense(data) {
        return data.keys().hasAll([
          'expenseDate', 'category', 'departmentId', 'entryMode',
          'amount', 'note', 'currency', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'expenseDate', 'category', 'departmentId', 'entryMode',
          'amount', 'note', 'currency', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.expenseDate is string
        && data.expenseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.category in ['transport', 'utilities', 'maintenance', 'office', 'meals', 'other']
        && data.departmentId in [0, 1, 2, 3]
        && data.entryMode in ['item', 'dailySummary']
        && data.amount is number
        && data.amount > 0
        && data.note is string
        && data.note.size() <= 300
        && data.currency == 'VND'
        && data.createdBy is string
        && data.createdBy.size() > 0;
      }

      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && validExpense(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validExpense(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validDailyRecord(data) {
      return data.keys().hasAll([
        'workDate', 'departmentId', 'headcount', 'outputQuantity',
        'unitPrice', 'dailyWagePerPerson', 'materialCost', 'otherCost',
        'revenue', 'laborCost', 'netProfit', 'currency',
        'createdBy', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'workDate', 'departmentId', 'headcount', 'outputQuantity',
          'unitPrice', 'dailyWagePerPerson', 'materialCost', 'otherCost',
          'revenue', 'laborCost', 'netProfit', 'currency',
          'createdBy', 'createdAt', 'updatedAt', 'lastAuditLogId'
        ])
        && data.workDate is string
        && data.workDate.size() == 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.departmentId is int
        && data.departmentId in [1, 2, 3]
        && data.headcount is int
        && data.headcount >= 0
        && data.outputQuantity is int
        && data.outputQuantity >= 0
        && data.unitPrice is number
        && data.unitPrice >= 0
        && data.dailyWagePerPerson is number
        && data.dailyWagePerPerson >= 0
        && data.materialCost is number
        && data.materialCost >= 0
        && data.otherCost is number
        && data.otherCost >= 0
        && data.revenue is number
        && data.revenue == data.outputQuantity * data.unitPrice
        && data.laborCost is number
        && data.laborCost == data.headcount * data.dailyWagePerPerson
        && data.netProfit is number
        && data.netProfit == data.revenue - data.laborCost - data.materialCost - data.otherCost
        && data.currency == 'VND'
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 128;
    }


    match /dailyRecords/{recordId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && validDailyRecord(request.resource.data)
        && request.resource.data.lastAuditLogId == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validDailyRecord(request.resource.data)
        && request.resource.data.workDate == resource.data.workDate
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastAuditLogId is string
        && existsAfter(/databases/$(database)/documents/dailyRecordAuditLogs/$(request.resource.data.lastAuditLogId))
        && getAfter(/databases/$(database)/documents/dailyRecordAuditLogs/$(request.resource.data.lastAuditLogId)).data.recordId == recordId
        && getAfter(/databases/$(database)/documents/dailyRecordAuditLogs/$(request.resource.data.lastAuditLogId)).data.before == resource.data
        && getAfter(/databases/$(database)/documents/dailyRecordAuditLogs/$(request.resource.data.lastAuditLogId)).data.after == request.resource.data;
      allow delete: if false;
    }

    match /dailyRecordAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'recordId', 'workDate', 'departmentId', 'before', 'after',
          'changedBy', 'changedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'recordId', 'workDate', 'departmentId', 'before', 'after',
          'changedBy', 'changedAt'
        ])
        && request.resource.data.recordId is string
        && request.resource.data.workDate is string
        && request.resource.data.departmentId in [1, 2, 3]
        && request.resource.data.before is map
        && request.resource.data.after is map
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.changedAt == request.time
        && exists(/databases/$(database)/documents/dailyRecords/$(request.resource.data.recordId))
        && existsAfter(/databases/$(database)/documents/dailyRecords/$(request.resource.data.recordId))
        && request.resource.data.before == get(/databases/$(database)/documents/dailyRecords/$(request.resource.data.recordId)).data
        && request.resource.data.after == getAfter(/databases/$(database)/documents/dailyRecords/$(request.resource.data.recordId)).data
        && getAfter(/databases/$(database)/documents/dailyRecords/$(request.resource.data.recordId)).data.lastAuditLogId == logId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
